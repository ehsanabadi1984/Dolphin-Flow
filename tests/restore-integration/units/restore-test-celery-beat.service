[Unit]
Description=Restore Integration Test - Celery Beat
After=network.target

[Service]
Type=simple
User=restoretest
WorkingDirectory=/app
EnvironmentFile=/run/restore-test.env
ExecStart=/opt/venv/bin/celery -A config beat --loglevel=INFO --schedule=/tmp/restore-test-celerybeat-schedule
Restart=on-failure

[Install]
WantedBy=multi-user.target
