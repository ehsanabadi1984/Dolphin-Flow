# ==========================
# Dolphin Flow Backend .ev.example
# ==========================

DJANGO_SECRET_KEY=change_me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=dolphinflow
DB_USER=dolphin
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=5432

TZ=Asia/Tehran

# Backup
BACKUP_ROOT=/opt/dolphinplus/backups
# Optional OS-mounted SMB/NFS destination
BACKUP_NETWORK_ROOT=

# Magfa SMS provider (credentials are secrets; never store them in the database)
SMS_PROVIDER_CLASS=workflow.sms_services.MagfaSMSProvider
MAGFA_API_BASE_URL=https://sms.magfa.com/api/http/sms/v2
MAGFA_USERNAME=
MAGFA_PASSWORD=
MAGFA_DOMAIN=
MAGFA_SENDER=
MAGFA_TIMEOUT=10
SMS_OTP_LENGTH=6
SMS_OTP_TTL_SECONDS=300
SMS_OTP_RESEND_COOLDOWN_SECONDS=60
SMS_OTP_MAX_ATTEMPTS=5
SMS_OTP_DAILY_USER_LIMIT=5
SMS_OTP_DAILY_PHONE_LIMIT=3

# Maximum allowed SMS parts before using the short fallback message
SMS_MAX_SEGMENTS=2
SMS_FALLBACK_MESSAGE=شما یک اعلان جدید در سامانه فرآیندها دارید. برای مشاهده جزئیات وارد سامانه شوید.
