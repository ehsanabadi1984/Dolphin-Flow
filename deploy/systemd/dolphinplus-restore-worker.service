[Unit]
Description=Dolphin-Flow dedicated restore cutover worker
After=network.target redis-server.service postgresql.service
Wants=network.target

[Service]
Type=simple
User=ehsan
Group=ehsan
WorkingDirectory=/opt/dolphinplus/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/dolphinplus/backend/.venv/bin/celery -A config worker --queues=restore_cutover --concurrency=1 --prefetch-multiplier=1 --hostname=restore@%H
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=300
UMask=0077

[Install]
WantedBy=multi-user.target
